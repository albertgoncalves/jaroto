#!/usr/bin/env bash

export WD=$PWD

if [ ! -d "$WD/build" ]; then
    mkdir "$WD/build"
fi

export flags=(
    -classpath "$WD/build"
    -d "$WD/build"
    -deprecation
    -g
    -source 25 --enable-preview
    -Werror
    -Xlint:all
    -Xmaxerrs 1
)

runj () {
    handle=$(basename "${1%%.*}")
    clang-format -i -verbose "$1" || return
    javac "${flags[@]}" "$1" || return
    java --enable-preview -ea -cp .:"$WD/build" "$handle" $@
}

export -f runj
alias javap="javap -v -l -c -s -p -constants"
alias javajdb="java -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=7896 --enable-preview -ea -cp .:$WD/build"
alias jdb="jdb -attach 7896 -sourcepath $WD/src/"
